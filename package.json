{
  "name": "math-diagrammer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A compositional JavaScript DSL for precise static mathematics diagrams.",
  "exports": {
    ".": "./src/index.js",
    "./math": "./src/math/index.js",
    "./geometry": "./src/geometry/index.js"
  },
  "scripts": {
    "dev": "vite app",
    "build": "vite build app --outDir ../dist --emptyOutDir",
    "docs:dev": "vitepress dev docs --port 5175",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --port 4175",
    "test": "node --test",
    "check": "npm run test && npm run build && npm run docs:build"
  },
  "devDependencies": {
    "shiki": "^2.5.0",
    "vite": "^7.1.1",
    "vitepress": "^1.6.4"
  },
  "dependencies": {
    "mathjax-full": "^3.2.2"
  },
  "overrides": {
    "vitepress": {
      "vite": "$vite"
    }
  }
}
